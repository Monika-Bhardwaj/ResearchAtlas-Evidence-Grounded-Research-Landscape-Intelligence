{
  "$defs": {
    "AmbiguousTerm": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Candidates",
          "type": "array"
        },
        "input": {
          "minLength": 1,
          "title": "Input",
          "type": "string"
        },
        "status": {
          "default": "AMBIGUOUS",
          "pattern": "^AMBIGUOUS$",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "input",
        "candidates"
      ],
      "title": "AmbiguousTerm",
      "type": "object"
    },
    "ClaimBasis": {
      "description": "Section 53: every output claim falls into exactly one of these.",
      "enum": [
        "DIRECTLY_SUPPORTED",
        "RULE_DERIVED",
        "AGGREGATED_FROM_EVIDENCE",
        "USER_PROVIDED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "ClaimBasis",
      "type": "string"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/ClaimBasis"
        },
        "edge_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edge Id"
        },
        "fragment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fragment"
        },
        "paper_id": {
          "anyOf": [
            {
              "pattern": "^paper:[a-z0-9][a-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Id"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "source_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Field"
        }
      },
      "required": [
        "basis"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "EvidenceSufficiency": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "INSUFFICIENT"
      ],
      "title": "EvidenceSufficiency",
      "type": "string"
    },
    "Facet": {
      "additionalProperties": false,
      "properties": {
        "ambiguous_terms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AmbiguousTerm"
          },
          "title": "Ambiguous Terms",
          "type": "array"
        },
        "facet_id": {
          "minLength": 1,
          "title": "Facet Id",
          "type": "string"
        },
        "facet_text": {
          "minLength": 1,
          "title": "Facet Text",
          "type": "string"
        },
        "grounded_concepts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Grounded Concepts",
          "type": "array"
        },
        "unknown_terms": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unknown Terms",
          "type": "array"
        }
      },
      "required": [
        "facet_id",
        "facet_text"
      ],
      "title": "Facet",
      "type": "object"
    },
    "FacetPositioning": {
      "additionalProperties": false,
      "properties": {
        "abstain": {
          "title": "Abstain",
          "type": "boolean"
        },
        "confidence_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_sufficiency": {
          "$ref": "#/$defs/EvidenceSufficiency"
        },
        "facet_id": {
          "minLength": 1,
          "title": "Facet Id",
          "type": "string"
        },
        "facet_text": {
          "minLength": 1,
          "title": "Facet Text",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/PositioningLabel"
        }
      },
      "required": [
        "facet_id",
        "facet_text",
        "label",
        "abstain",
        "confidence_score",
        "evidence_sufficiency"
      ],
      "title": "FacetPositioning",
      "type": "object"
    },
    "LimitationReport": {
      "additionalProperties": false,
      "description": "An ATTRIBUTED assertion: 'paper P reports that method M has limitation L'.",
      "properties": {
        "attribution": {
          "pattern": "^(SELF_REPORTED|THIRD_PARTY)$",
          "title": "Attribution",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "limitation_id": {
          "title": "Limitation Id",
          "type": "string"
        },
        "method_id": {
          "title": "Method Id",
          "type": "string"
        },
        "reported_by": {
          "pattern": "^paper:[a-z0-9][a-z0-9_.\\-]*$",
          "title": "Reported By",
          "type": "string"
        }
      },
      "required": [
        "method_id",
        "limitation_id",
        "reported_by",
        "attribution",
        "evidence"
      ],
      "title": "LimitationReport",
      "type": "object"
    },
    "PositioningLabel": {
      "enum": [
        "WELL_EXPLORED",
        "PARTIALLY_EXPLORED",
        "UNDERREPRESENTED",
        "UNKNOWN"
      ],
      "title": "PositioningLabel",
      "type": "string"
    },
    "PriorWorkItem": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/EvidenceSufficiency"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Evidence",
          "type": "array"
        },
        "paper_id": {
          "pattern": "^paper:[a-z0-9][a-z0-9_.\\-]*$",
          "title": "Paper Id",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "shared_concepts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Shared Concepts",
          "type": "array"
        },
        "shared_methods": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Shared Methods",
          "type": "array"
        }
      },
      "required": [
        "paper_id",
        "score",
        "confidence"
      ],
      "title": "PriorWorkItem",
      "type": "object"
    },
    "ProposalGrounding": {
      "additionalProperties": false,
      "properties": {
        "ambiguous_concepts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AmbiguousTerm"
          },
          "title": "Ambiguous Concepts",
          "type": "array"
        },
        "facets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Facet"
          },
          "title": "Facets",
          "type": "array"
        },
        "matched_concepts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Matched Concepts",
          "type": "array"
        },
        "raw_text": {
          "title": "Raw Text",
          "type": "string"
        },
        "unknown_concepts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unknown Concepts",
          "type": "array"
        }
      },
      "required": [
        "raw_text"
      ],
      "title": "ProposalGrounding",
      "type": "object"
    },
    "ReadingPathItem": {
      "additionalProperties": false,
      "properties": {
        "concepts_learned": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Concepts Learned",
          "type": "array"
        },
        "paper_id": {
          "pattern": "^paper:[a-z0-9][a-z0-9_.\\-]*$",
          "title": "Paper Id",
          "type": "string"
        },
        "prerequisites": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "relationship_to_proposal": {
          "minLength": 1,
          "title": "Relationship To Proposal",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "paper_id",
        "reason",
        "relationship_to_proposal"
      ],
      "title": "ReadingPathItem",
      "type": "object"
    },
    "Tension": {
      "additionalProperties": false,
      "properties": {
        "challenging_evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Challenging Evidence",
          "type": "array"
        },
        "claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "facet_id": {
          "minLength": 1,
          "title": "Facet Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TensionStatus"
        },
        "supporting_evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          },
          "title": "Supporting Evidence",
          "type": "array"
        }
      },
      "required": [
        "facet_id",
        "status"
      ],
      "title": "Tension",
      "type": "object"
    },
    "TensionStatus": {
      "enum": [
        "CONFLICTING",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "TensionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_sufficiency": {
      "$ref": "#/$defs/EvidenceSufficiency"
    },
    "limitations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LimitationReport"
      },
      "title": "Limitations",
      "type": "array"
    },
    "positioning": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FacetPositioning"
      },
      "title": "Positioning",
      "type": "array"
    },
    "prior_work": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PriorWorkItem"
      },
      "title": "Prior Work",
      "type": "array"
    },
    "proposal": {
      "$ref": "#/$defs/ProposalGrounding"
    },
    "reading_path": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReadingPathItem"
      },
      "title": "Reading Path",
      "type": "array"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "tensions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Tension"
      },
      "title": "Tensions",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "proposal",
    "evidence_sufficiency"
  ],
  "title": "RuntimeOutput",
  "type": "object"
}
